# Alexander Colon site - environment variables
#
# Every value here is read server side only. Nothing in this file is prefixed
# NEXT_PUBLIC_, which means nothing here can be bundled into client JavaScript.
# Copy to .env.local for development. Set the real values in Vercel's
# Environment Variables screen for preview and production.
#
# Hard stop 9: no secrets in the repo, git history included.

# ---------------------------------------------------------------------------
# Site identity
# ---------------------------------------------------------------------------
# Canonical origin, no trailing slash. Used for canonical tags, sitemap,
# JSON-LD and the origin allowlist below.
SITE_ORIGIN=https://example.com

# Comma separated list of origins allowed to POST to the API routes.
# Include both apex and www, and any Vercel preview domain you test from.
ALLOWED_ORIGINS=https://example.com,https://www.example.com

# ---------------------------------------------------------------------------
# Lead sinks, in delivery order: Sheet is the source of truth
# ---------------------------------------------------------------------------
# Google Apps Script web app URL that appends a row to the leads Sheet.
LEAD_SHEET_WEBHOOK_URL=
LEAD_SHEET_SHARED_SECRET=

# ProyTech CRM ingest endpoint and key.
CRM_LEAD_ENDPOINT=
CRM_API_KEY=

# GoHighLevel inbound webhook for automations, and the location it belongs to.
GHL_WEBHOOK_URL=
GHL_LOCATION_ID=

# Where the instant notification goes. Speed to lead depends on this.
NOTIFY_EMAIL_ENDPOINT=
NOTIFY_EMAIL_TO=

# ---------------------------------------------------------------------------
# Assistant (server side only, never exposed to the browser)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Model is pinned in config, override here only to roll forward deliberately.
ANTHROPIC_MODEL=claude-haiku-4-5

# ---------------------------------------------------------------------------
# Rate limiting. Upstash Redis, per the security review. Serverless functions
# do not share memory between invocations, so an in-memory limiter silently
# does nothing. If these are unset the app logs a loud warning on every
# guarded request and the other guards still apply.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
